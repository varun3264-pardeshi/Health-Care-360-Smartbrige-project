# ==============================================================================
# CHRONIC DISEASE INTELLIGENCE SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and adjust variables as required.
# NEVER commit .env to version control.

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=false
APP_NAME="PulsePoint Cyber-Medical Intelligence"
APP_VERSION="2.4.0"

# Server Ports and Hosts
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Security & Authentication
# Generate a secure 64-character secret in production using: openssl rand -hex 32
SECRET_KEY=change-this-in-production-cyber-medical-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
SESSION_TIMEOUT_MINUTES=60

# Database Configuration
DATABASE_URL=sqlite:///data/healthcare_intelligence.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/healthcare_intelligence

# Data Privacy & Governance
DEMO_MODE=true
MASK_PATIENT_IDENTIFIERS=true
ENABLE_AUDIT_LOGGING=true
SMALL_CELL_SUPPRESSION_THRESHOLD=5

# Notification Settings
ENABLE_EMAIL_ALERTS=false
ALERT_EMAIL_RECIPIENT=clinical-alerts@example-hospital.org
